<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="96" height="96">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E40AF"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
    <linearGradient id="branchGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#DBEAFE"/>
      <stop offset="100%" stop-color="#93C5FD"/>
    </linearGradient>
  </defs>

  <!-- Rounded square background matching Ascentix blue -->
  <rect x="4" y="4" width="88" height="88" rx="18" ry="18" fill="url(#bgGrad)"/>

  <!-- Ascending peak (Ascentix brand mark, subtle in background) -->
  <path d="M24 72 L38 28 L52 72" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.15"/>
  <path d="M34 72 L48 28 L62 72" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.1"/>

  <!-- Decision tree / branching rules structure -->
  <!-- Root node (top) -->
  <circle cx="48" cy="22" r="5" fill="#FFFFFF"/>

  <!-- Trunk line from root -->
  <line x1="48" y1="27" x2="48" y2="38" stroke="#DBEAFE" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Branch point -->
  <circle cx="48" cy="40" r="3.5" fill="url(#branchGrad)"/>

  <!-- Left branch -->
  <path d="M48 40 L30 54" fill="none" stroke="#DBEAFE" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Left decision node -->
  <rect x="22" y="52" width="16" height="10" rx="3" fill="#FFFFFF" opacity="0.9"/>

  <!-- Right branch -->
  <path d="M48 40 L66 54" fill="none" stroke="#DBEAFE" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Right decision node -->
  <rect x="58" y="52" width="16" height="10" rx="3" fill="#FFFFFF" opacity="0.9"/>

  <!-- Second level branches from left node -->
  <path d="M30 62 L22 72" fill="none" stroke="#93C5FD" stroke-width="2" stroke-linecap="round"/>
  <path d="M30 62 L38 72" fill="none" stroke="#93C5FD" stroke-width="2" stroke-linecap="round"/>

  <!-- Second level branches from right node -->
  <path d="M66 62 L58 72" fill="none" stroke="#93C5FD" stroke-width="2" stroke-linecap="round"/>
  <path d="M66 62 L74 72" fill="none" stroke="#93C5FD" stroke-width="2" stroke-linecap="round"/>

  <!-- Leaf nodes (outcomes) -->
  <circle cx="22" cy="74" r="3" fill="#93C5FD" opacity="0.8"/>
  <circle cx="38" cy="74" r="3" fill="#93C5FD" opacity="0.8"/>
  <circle cx="58" cy="74" r="3" fill="#93C5FD" opacity="0.8"/>
  <circle cx="74" cy="74" r="3" fill="#93C5FD" opacity="0.8"/>

  <!-- Small checkmarks in leaf nodes to suggest rule validation -->
  <path d="M20 74 L21.5 75.5 L24 72.5" fill="none" stroke="#1E40AF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M36 74 L37.5 75.5 L40 72.5" fill="none" stroke="#1E40AF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M56 74 L57.5 75.5 L60 72.5" fill="none" stroke="#1E40AF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M72 74 L73.5 75.5 L76 72.5" fill="none" stroke="#1E40AF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>