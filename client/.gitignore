node_modules/
dist/
# Generated by scripts/build-docs.mjs from docs/guide. docs.ts is committed on purpose even
# though it is generated: the editor imports it at module load, so `npm test` fails without it
# on a clean clone. Ignore the directory's contents, then re-include that one file. Git cannot
# re-include a file inside an excluded DIRECTORY, hence the trailing /* rather than a bare /.
src/editor/help/generated/*
!src/editor/help/generated/docs.ts

# Playwright test-run artifacts (Layer 3 e2e) — never commit
test-results/
playwright-report/
